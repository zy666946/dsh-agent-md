{
  "name": "dsh-agent-md",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "AGENT.md 人格配置：用 Markdown 给模型配人格，全局一份 + 每个项目一份（项目覆盖全局）。内置「干饭鱼」女儿人格，装上就有性格，也可在设置页可视化编辑；内置人格观察、版本快照与候选 diff。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "persona",
    "agent-md",
    "personality",
    "ganfanyu"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zy666946/dsh-agent-md.git"
  },
  "homepage": "https://github.com/zy666946/dsh-agent-md#readme",
  "bugs": {
    "url": "https://github.com/zy666946/dsh-agent-md/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
